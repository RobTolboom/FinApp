# Kopieer dit bestand naar .env en vul je eigen waarden in.
# .env staat in .gitignore en komt dus nooit op GitHub.

# Verplicht zodra FinApp vanaf het thuisnetwerk bereikbaar is.
# Zet het wachtwoord tussen enkele aanhalingstekens als er een $, een # of
# een spatie in zit, bijvoorbeeld: FINAPP_PASSWORD='kies een $terk wachtwoord'
FINAPP_PASSWORD=

# Gebruikersnaam bij het inloggen (standaard: finapp).
# FINAPP_USER=finapp

# Bewust zonder wachtwoord draaien op het thuisnetwerk? Haal het hekje weg.
# FINAPP_NO_PASSWORD=1
